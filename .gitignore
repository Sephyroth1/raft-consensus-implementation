
# ---------------------------------------------------------------------------
# Binaries and Executables
# ---------------------------------------------------------------------------
# Compiled applications and main execution files
*.exe
*.exe~
*.dll
*.so
*.dylib

# Architecture-specific binary outputs (if you use custom build folders)
bin/
obj/

# ---------------------------------------------------------------------------
# Test and Coverage Artifacts
# ---------------------------------------------------------------------------
# Test binaries generated via `go test -c`
*.test

# Coverage profiles generated by `go test -coverprofile`
*.out
*.coverprofile
profile.cov

# ---------------------------------------------------------------------------
# Local Workspaces and Environments
# ---------------------------------------------------------------------------
# Multi-module workspace files (should stay local to your machine)
go.work
go.work.sum

# Local environment variables containing credentials/secrets
.env
.env-local

# ---------------------------------------------------------------------------
# Dependencies (Optional)
# ---------------------------------------------------------------------------
# Uncomment this if you vendor your dependencies rather than fetching them online
# vendor/

# ---------------------------------------------------------------------------
# IDEs and System Files (Often kept in global gitignore instead)
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
